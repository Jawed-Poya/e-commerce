# Use your computer's LAN IP when running on a physical phone.
# Android emulator fallback: http://10.0.2.2:5188/api
# iOS simulator fallback: http://localhost:5188/api
EXPO_PUBLIC_API_URL=http://192.168.1.100:5188/api
EXPO_PUBLIC_ASSET_URL=http://192.168.1.100:5188

# Optional: host this small JSON file so production API URLs can be changed
# without rebuilding. Manual in-app server settings take precedence.
# File contents: {"apiUrl":"https://shop.example.com/api","assetUrl":"https://shop.example.com"}
EXPO_PUBLIC_RUNTIME_CONFIG_URL=https://config.example.com/easycart-mobile.json

# EAS project UUID required for remote push notifications in native builds.
EXPO_PUBLIC_EAS_PROJECT_ID=00000000-0000-0000-0000-000000000000
