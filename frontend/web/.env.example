VITE_API_BASE_URL=/api
VITE_ASSET_BASE_URL=/

# Google sign-in is configured by the backend through GoogleAuth:ClientId.

# Public APK or app-store URL used by the footer and mobile-app prompt.
VITE_MOBILE_APP_DOWNLOAD_URL=/downloads/easycart-mobile.apk
# Do not duplicate the Google client ID here; the storefront fetches it from
# GET /api/auth/customer/google/config so token validation always uses the same ID.
