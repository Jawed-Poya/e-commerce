{
  "name": "Default Company Store",
  "short_name": "Default Co.",
  "description": "Browse products, track orders, receive price and stock alerts, and shop from any device.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "prefer_related_applications": false,
  "orientation": "any",
  "background_color": "#ffffff",
  "theme_color": "#0B1F3A",
  "categories": ["shopping", "business"],
  "shortcuts": [
    { "name": "Shop products", "short_name": "Shop", "url": "/products", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }] },
    { "name": "Shopping cart", "short_name": "Cart", "url": "/cart", "icons": [{ "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png" }] }
  ],
  "icons": [
    { "src": "/pwa-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/pwa-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
